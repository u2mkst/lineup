# Supabase (Project Settings -> API). The publishable key is safe to ship to the browser;
# access is enforced by Row Level Security. Without these the app runs offline-only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: KakaoTalk card sharing (Kakao Developers > App > JavaScript key).
# Also register the site's address under Platform > Web.
VITE_KAKAO_JS_KEY=
